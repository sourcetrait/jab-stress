# PoolCore's rules, each broken by exact-once finds and puts on a
# candidate copy of src/ (operation.md: the program's mutants against the
# suite); `expect` is the head of the assertion in test.nu that must fail
# first. A change to a rule's source moves its finds here in the same pass.
[
  {
    name: generation_unchecked,
    file: "raster.S",
    edits: [{ find: "    srli a0, a2, 16
    slli a0, a0, 16
    ori a0, a0, SLOT_READY
    beq a0, a4, 80f                 # its generation's, READY: the tile
", put: "    andi a4, a4, 0xff
    li a0, SLOT_READY
    beq a0, a4, 80f                 # its generation's, READY: the tile
" }],
    expect: "the stale entries read no tile"
  },
  {
    name: boundary_after_snapshot,
    file: "world.S",
    edits: [{ find: "    call tile_boundary              # the pool's one change a frame, before any bind
.ifdef DEBUG
    la t0, tile_writes
    ld t1, 0(t0)
    la t0, tile_writes_frozen
    sd t1, 0(t0)                    # the pool frozen from here to the last join
.endif
", put: ".ifdef DEBUG
    la t0, tile_writes
    ld t1, 0(t0)
    la t0, tile_writes_frozen
    sd t1, 0(t0)                    # the pool frozen from here to the last join
.endif
    call tile_boundary              # the pool's one change a frame, before any bind
" }],
    expect: "the tile pool held unchanged through every frame's renders on render_1"
  },
  {
    name: rings_never_merged,
    file: "tile.S",
    edits: [{ find: "    la t0, tile_merge_cursor
    sd s6, 0(t0)
    la t0, tile_context_cursor
    ld s8, 0(t0)", put: "    la t0, tile_merge_cursor
    sd s6, 0(t0)
    j 90f
    la t0, tile_context_cursor
    ld s8, 0(t0)" }],
    expect: "the warming frame merged every request the frame before made"
  },
  {
    name: built_pass_evicted,
    file: "tile.S",
    edits: [{ find: "    beq t6, t4, 1b                  # built this pass
", put: "" }],
    expect: "the pool's stale complete and valid at schema 6"
  },
  {
    name: straddling_requests,
    file: "raster.S",
    edits: [{ find: "4330:
    ld a0, CTX_TILE_STRADDLING(tp)
", put: "4330:
    sra a0, s8, a6
    sra a1, s9, a6
    lhu a3, (TS_GRIDS + TS_GRID_W)(a7)
    bgeu a0, a3, 4331f
    lhu a4, (TS_GRIDS + TS_GRID_H)(a7)
    bgeu a1, a4, 4331f
    lwu a4, (TS_GRIDS + TS_GRID_BASE)(a7)
    mul a1, a1, a3
    add a1, a1, a0
    add a1, a1, a4
    sd a1, 240(sp)
4331:
    ld a0, CTX_TILE_STRADDLING(tp)
" }],
    expect: "first sight settled under the ordinary budget"
  },
  {
    name: merge_restarts_word,
    file: "tile.S",
    edits: [{ find: "80:
    li t0, LUMAP_COUNT
    bltu s6, t0, 81f
    li s6, 0
81:
", put: "80:
    srli s6, s6, 6
    slli s6, s6, 6
    li t0, LUMAP_COUNT
    bltu s6, t0, 81f
    li s6, 0
81:
" }],
    expect: "every surface requesting under the rotation built within"
  },
  {
    name: misses_at_judgement,
    file: "raster.S",
    edits: [
      { find: "4320:
    sd a1, 240(sp)                  # missed: asked for at the block's end if it draws
", put: "4320:
    sd a1, 240(sp)                  # missed: asked for at the block's end if it draws
    ld a0, CTX_TILE_MISSES(tp)
    addi a0, a0, 1
    sd a0, CTX_TILE_MISSES(tp)
" },
      { find: "    ld a1, CTX_TILE_MISSES(tp)
    addi a1, a1, 1
    sd a1, CTX_TILE_MISSES(tp)      # drawn without its tile
", put: "" }
    ],
    expect: "the walk's measurement valid"
  }
]
