  {name: tc_lighting_named, file: "tilecensus.nu", find: "(if ($lightings | length) > 1 {", put: "(if false {", expect: "holds: a second lighting revision named"}
  {name: tc_mismatch_named, file: "tilecensus.nu", find: "(if $mismatches > 0 {", put: "(if false {", expect: "holds: a mismatch named"}
  {name: tc_unparsed_named, file: "tilecensus.nu", find: "(if $unparsed > 0 {", put: "(if false {", expect: "holds: an unparsed frame line named"}
  {name: tc_ordered_named, file: "tilecensus.nu", find: "(if $ordered { null } else { \"the rows are not every frame from 0 in order\" })", put: "null", expect: "holds: rows not every frame from 0 named"}
  {name: tc_directory_named, file: "tilecensus.nu", find: "(if $directory == null { \"the log holds no census directory\" } else { null })", put: "null", expect: "holds: no directory named"}
  {name: tc_contexts_from_lines, file: "tilecensus.nu", find: "each {|r| $r.directory } | compact | each {|d| $d.contexts } | append 0 | math max)", put: "each {|r| $r.frames | each {|f| $f.sides | each {|s| $s.contexts | length } } } | flatten | flatten | append 0 | math max)", expect: "holds: a first-format directory over eight contexts read as three"}
  {name: tc_contexts_fixed, file: "tilecensus.nu", find: "per_context: (0..<$context_count | each {|i|", put: "per_context: (0..<3 | each {|i|", expect: "holds: the eight-context batch read over its directories' eight contexts"}
]
