[
  {name: tc_standing_valid, file: "tilecensus_resolve.nu", find: "if not ($m.complete and $m.valid) {", put: "if not $m.complete {", expect: "holds: a capture complete and invalid"}
  {name: tc_standing_complete, file: "tilecensus_resolve.nu", find: "if not ($m.complete and $m.valid) {", put: "if not $m.valid {", expect: "holds: a capture incomplete"}
