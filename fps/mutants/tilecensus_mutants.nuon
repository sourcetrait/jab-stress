  {name: tc_seed, file: "tilecensus_resolve.nu", find: "if $seed != $r.seed {", put: "if false {", expect: "holds: a run's seed not its identity's"}
  {name: tc_pixel, file: "tilecensus.nu", find: "let refused = (if ($c.over | is-empty) { [] } else {", put: "let refused = (if true { [] } else {", expect: "holds: a census frame's mapped pixels past its row's lit pixels"}
  {name: tc_aggregate, file: "tilecensus.nu", find: "let recs = ($runs | where {|r| $r.refused | is-empty } | each {|r|", put: "let recs = ($runs | each {|r|", expect: "holds: a refused run summarized nowhere"}
  {name: tc_short, file: "tilecensus.nu", find: "short: ($streak >= $SHORT)", put: "short: true", expect: "holds: an invalid frame's 30-frame windows"}
  {name: tc_long, file: "tilecensus.nu", find: "long: ($streak >= $WINDOW)", put: "long: true", expect: "holds: an invalid frame's 120-frame windows"}
  {name: tc_invalid_reset, file: "tilecensus.nu", find: "$streak = (if not $f.valid { 0 } else if", put: "$streak = (if false { 0 } else if", expect: "holds: an invalid frame's 30-frame windows"}
  {name: tc_gap_reset, file: "tilecensus.nu", find: "} else if $f.frame == $previous + 1 { $streak + 1 } else { 1 })", put: "} else { $streak + 1 })", expect: "holds: a missing frame's 30-frame windows"}
  {name: tc_missing_named, file: "tilecensus.nu", find: "(if $missing > 0 { $\"($missing) measured frames with no census\" } else { null })", put: "null", expect: "holds: a missing frame named"}
  {name: tc_invalid_named, file: "tilecensus.nu", find: "(if ($invalid | is-empty) { null } else { $\"($invalid | length) measured census frames invalid, the first ($invalid | first | to nuon)\" })", put: "null", expect: "holds: an invalid frame named"}
  {name: tc_gaps_named, file: "tilecensus.nu", find: "(if ($gaps | is-empty) { null } else { $\"gaps in the census frames: ($gaps | to nuon)\" })", put: "null", expect: "holds: gaps named"}
