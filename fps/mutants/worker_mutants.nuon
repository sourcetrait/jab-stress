# The raster workers' rules, TwoWorkers', GfxStorage's, GfxSelection's, and
# GfxScaling's (the guideline, the cancel's witness), each broken by
# exact-once finds and puts on a
# candidate copy of src/ (operation.md: the program's mutants against the
# suite); `expect` is the head of the assertion in test.nu that must fail
# first. A change to a rule's source moves its finds here in the same pass.
[
  {
    name: clear_unowned,
    file: "workers.S",
    edits: [{ find: "    sw t2, ROUND_FLAGS(s0)          # the clear with it
", put: "    sw zero, ROUND_FLAGS(s0)        # the clear with it
" }],
    expect: "the sky's top band at [960, 100] from the yard"
  },
  {
    name: band_short,
    file: "workers.S",
    edits: [{ find: "    mul a1, t4, t3
    divu a1, a1, t2
    mv a2, s5
    call band_render
    li s6, 1
", put: "    mul a1, t4, t3
    divu a1, a1, t2
    addi a1, a1, -1
    mv a2, s5
    call band_render
    li s6, 1
" }],
    expect: "the spawn view by 1 workers in bands of 0 rows counts as the default's"
  },
  {
    name: join_skipped,
    file: "workers.S",
    edits: [{ find: "5:
    li t0, JAB_HARTS_MAX
    bgeu s4, t0, 6f
", put: "5:
    addi t0, s1, -1
    bgeu s3, t0, 6f
    li t0, JAB_HARTS_MAX
    bgeu s4, t0, 6f
" }],
    expect: "a screen was taken on the plain run"
  },
  {
    name: counts_unsummed,
    file: "workers.S",
    edits: [{ find: "    call context_counts             # its counts, the frame's
", put: "" }],
    expect: "the walk's measurement valid"
  },
  {
    name: context_shared,
    file: "workers.S",
    edits: [{ find: "    slli t0, s2, CTX_SHIFT
    la tp, worker_contexts
    add tp, tp, t0                  # its context
", put: "    la tp, worker_contexts          # its context
" }],
    expect: "no program or worker fault drawing the plain run's frames"
  },
  {
    name: cancel_dropped,
    file: "workers.S",
    edits: [{ find: "    call round_finish               # the bands the cancelled jobs left, on hart 0
", put: "    li a0, 0
" }],
    expect: "the first frame and the pose's two placements reported on the spawn view with every round cancelled"
  },
  {
    name: claim_short,
    file: "workers.S",
    edits: [{ find: "    bgeu t2, s9, 8f                 # every band claimed
", put: "    addi t3, s9, -1
    bgeu t2, t3, 8f                 # every band claimed
" }],
    expect: "a screen was taken on the plain run"
  },
  {
    name: record_workers_zero,
    file: "main.S",
    edits: [{ find: "    sw t2, PACKET_WORKERS(t1)       # the frame's workers, 0 for the serial backend
", put: "    sw zero, PACKET_WORKERS(t1)     # the frame's workers, 0 for the serial backend
" }],
    expect: "frames of the serial backend carrying a round's time"
  },
  {
    name: record_times_unconverted,
    file: "main.S",
    edits: [{ find: "    ld t2, STAT_SLOWEST(t3)
    divu t2, t2, t6
    sw t2, PACKET_SLOWEST(t1)", put: "    ld t2, STAT_SLOWEST(t3)
    sw t2, PACKET_SLOWEST(t1)" }],
    expect: "frames whose slowest worker, dispatch, or barrier is past their raster"
  },
  {
    name: record_busy_unconverted,
    file: "main.S",
    edits: [{ find: "    ld t2, STAT_BUSY(t3)
    divu t2, t2, t6
    sw t2, PACKET_BUSY(t1)", put: "    ld t2, STAT_BUSY(t3)
    sw t2, PACKET_BUSY(t1)" }],
    expect: "frames whose workers' busy time is past W times their slowest's"
  },
  {
    name: band_by_slot,
    file: "workers.S",
    edits: [{ find: "    ld t5, JOB_POSITION(s0)
    li t3, SCREEN_H
", put: "    mv t5, s2
    li t3, SCREEN_H
" }],
    expect: "the spawn view on 4 harts, jab.late=2, 7 workers asked in bands of 0 rows"
  },
  {
    name: reservation_skipped,
    file: "workers.S",
    edits: [{ find: "    jab.sys.harts.reserve JAB_RESERVED_GFX_HARTS
    bnez a0, 80f
    mv s1, a1                       # the grant
", put: "    mv s1, t0                       # the grant
" }],
    expect: "a screen was taken on the plain run"
  },
  {
    name: owner_none,
    file: "workers.S",
    edits: [{ find: "    li t2, JAB_OWNER_RESERVED
    jab.sys.worker.start s1, raster_worker, s3, s4, s5, t2
", put: "    li t2, JAB_OWNER_NONE
    jab.sys.worker.start s1, raster_worker, s3, s4, s5, t2
" }],
    expect: "the plain run names its workers"
  },
  {
    name: job_hart_unwritten,
    file: "workers.S",
    edits: [{ find: "    sd s1, JOB_HART(s0)             # its hart, ordered by the completion's fence
", put: "" }],
    expect: "the walk's measurement valid"
  },
  {
    name: bands_two_cleared,
    file: "world.S",
    edits: [{ find: "    addi t4, t1, STAT_SIZE
13:
", put: "    addi t4, t1, (STAT_BANDS + 16)
13:
" }],
    expect: "every band of every round rendered once on the spawn view on 4 harts 7 workers asked in bands of 0 rows"
  },
  {
    name: take_stop_skipped,
    file: "workers.S",
    edits: [{ find: "    jab.sys.worker.stop s1          # their workers, idle in their mailboxes, exit
    bnez a1, 75f                    # one forced: its job never completed
", put: "" }],
    expect: "the take on four harts stops hart 3's worker, then claims the hart"
  },
  {
    name: started_kept,
    file: "workers.S",
    edits: [{ find: "    la t0, workers_mask
    ld t1, 0(t0)
    not t2, s1
    and t1, t1, t2
    sd t1, 0(t0)                    # the started without them
", put: "    la t0, workers_mask
    ld t1, 0(t0)
" }],
    expect: "the take's taken dispatches to started harts inside the grant alone"
  },
  {
    name: restart_skipped,
    file: "workers.S",
    edits: [{ find: "    mv a0, s1
    call workers_restart            # a raster worker on each again, under the reservation
", put: "" }],
    expect: "the take and give-back on four harts by the default: hart 3's worker stopped and the hart claimed, then the claim released and the hart's worker started"
  },
  {
    name: floor_check_skipped,
    file: "workers.S",
    edits: [{ find: "    blt t2, t1, 71f                 # under the floor: refused before any stop
", put: "" }],
    expect: "the take on three harts refused under the floor, nothing stopped or claimed"
  },
  {
    name: guideline_ignored,
    file: "render.inc",
    edits: [{ find: ".set GFX_GUIDELINE, 3
", put: ".set GFX_GUIDELINE, GFX_SLOTS
" }],
    expect: "the default on 8 harts draws with GFX_GUIDELINE's 3 of its 7 started workers"
  },
  {
    name: witness_unwritten,
    file: "main.S",
    edits: [{ find: "    li t1, REPORT_SIZE
    jab.sys.api.write t0, t1
8:
", put: "8:
" }],
    expect: "the spawn view with every round cancelled, hart 2's worker held, at a band a worker: exactly one witness for every measured frame"
  },
  {
    name: witness_cancelled_zero,
    file: "main.S",
    edits: [{ find: "    ld t1, STAT_CANCELLED(t2)
    sw t1, ROUNDS_CANCELLED(t0)
", put: "    sw zero, ROUNDS_CANCELLED(t0)
" }],
    expect: "the spawn view with every round cancelled, hart 2's worker held, at a band a worker: exactly one witness for every measured frame"
  }
]
