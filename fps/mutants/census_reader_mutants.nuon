[
  {name: reader_no_directory, find: "[\"no census directory to read the frame against\"]", put: "[]", expect: "refuses a frame read without the directory"}
  {name: reader_continuation_open, find: "(if $last == null or not $open { false }", put: "(if $last == null { false }", expect: "refuses a continuation moved past the next side's line"}
  {name: reader_shape_missing, find: "let missing = ($expected | where {|t| $t not-in $read } | each {|t| $\"missing: ($t)\" })", put: "let missing = []", expect: "refuses a side's lines removed"}
  {name: reader_shape_repeated, find: "let repeated = ($read | uniq --repeated | each {|t| $\"repeated: ($t)\" })", put: "let repeated = []", expect: "refuses a side line repeated"}
  {name: reader_shape_unexpected, find: "let unexpected = ($read | where {|t| $t not-in $expected } | uniq | each {|t| $\"unexpected: ($t)\" })", put: "let unexpected = []", expect: "refuses a side the directory does not name"}
  {name: reader_shape_order, find: "if $read == $expected { return [] }", put: "return []", expect: "refuses a side's lines moved past the next side's"}
  {name: reader_surface_past, find: "($l.pairs | where surface >= $surfaces | each", put: "($l.pairs | where {|p| false } | each", expect: "refuses a surface past the directory's"}
  {name: reader_surface_twice, find: "($ids | uniq --repeated | each {|s| $\"side", put: "([] | each {|s| $\"side", expect: "refuses a surface twice in a list"}
  {name: reader_surface_count, find: "($l.pairs | where count < 1 | each", put: "($l.pairs | where {|p| false } | each", expect: "refuses a count under 1"}
  {name: reader_blocks, find: "(if ($s.eligible + $s.straddling + $s.outside) != $frame.blocks {", put: "(if false {", expect: "refuses the blocks unsummed"}
  {name: reader_requests_eligible, find: "(if $requests > $s.eligible {", put: "(if false {", expect: "refuses requests past the eligible"}
  {name: reader_requests_passing, find: "(if $requests > $frame.passing {", put: "(if false {", expect: "refuses requests past the passing"}
  {name: reader_distinct_requests, find: "($contexts | where {|c| $c.distinct > $c.requests } |", put: "($contexts | where {|c| false } |", expect: "refuses distinct tiles past requests"}
  {name: reader_zero_together, find: "($contexts | where {|c| ($c.requests == 0) != ($c.distinct == 0) } |", put: "($contexts | where {|c| false } |", expect: "refuses requests and distinct tiles apart"}
  {name: reader_demand_greatest, find: "(if $s.demand < $greatest {", put: "(if false {", expect: "refuses the demand under a context's"}
  {name: reader_demand_sum, find: "(if $s.demand > (total-of $distincts) {", put: "(if false {", expect: "refuses the demand past the contexts'"}
  {name: reader_classes_least, find: "(if ($s.planes + ([$s.walls $s.openings] | math max)) > $s.demand {", put: "(if false {", expect: "refuses the classes past the demand"}
  {name: reader_classes_most, find: "(if $s.demand > ($s.planes + $s.walls + $s.openings) {", put: "(if false {", expect: "refuses the demand past the classes"}
  {name: reader_sampled, find: "(if $s.demand > $s.sampled {", put: "(if false {", expect: "refuses the demand past the sampled"}
  {name: reader_checked, find: "(if $s.checked > $s.demand {", put: "(if false {", expect: "refuses checked past the demand"}
  {name: reader_mismatches, find: "(if $s.mismatches > $s.checked {", put: "(if false {", expect: "refuses mismatches past checked"}
  {name: reader_uniform_most, find: "(if $s.uniform > $s.demand {", put: "(if false {", expect: "refuses uniform past the demand"}
  {name: reader_uniform_least, find: "(if $s.uniform < ($s.checked - $s.mismatches) {", put: "(if false {", expect: "refuses uniform under checked less mismatches"}
  {name: reader_surfaces_union, find: "(if $s.surfaces != $union {", put: "(if false {", expect: "refuses the surfaces not the lists'"}
  {name: reader_w1, find: "(if $s.w1 != $s.demand {", put: "(if false {", expect: "refuses the whole working set not the demand"}
  {name: reader_p1, find: "(if $s.p1 != $s.planes {", put: "(if false {", expect: "refuses the planes' working set not the planes"}
  {name: reader_q1, find: "(if $s.q1 != ($s.demand - $s.planes) {", put: "(if false {", expect: "refuses the walls' working set not the demand less the planes"}
  {name: reader_window_sum, find: "| where {|x| $x.w != ($x.p + $x.q) } |", put: "| where {|x| false } |", expect: "refuses a window not its classes' sum"}
  {name: reader_monotone, find: "| where {|x| $x.a > $x.b or $x.b > $x.c } |", put: "| where {|x| false } |", expect: "refuses a window falling"}
  {name: reader_covers, find: "(if $listed_planes < $s.p1 or $listed_walls < $s.q1 {", put: "(if false {", expect: "refuses the lists short of the windows"}
  {name: reader_frame_passing, find: "(if $frame.passing > $frame.blocks {", put: "(if false {", expect: "refuses passing past the blocks"}
  {name: reader_contexts_from_lines, find: "frame-of ($lines | slice $s.item..<$end) $dir", put: "frame-of ($lines | slice $s.item..<$end) (if $dir == null { null } else { $dir | update contexts ($lines | slice $s.item..<$end | parse $HEAD | each {|h| $h.context } | uniq | length) })", expect: "refuses a directory naming eight over frames of three"}
  {name: reader_first_format_unread, find: "let parsed = (if not ($current | is-empty) { $current } else { $line | parse $DIRECTORY_FIRST | each {|d| $d | insert contexts $\"($FIRST_CONTEXTS)\" } })", put: "let parsed = $current", expect: "every census frame whole and accounting", expect_eight: "refuses a first-format directory over frames of eight for it"}
]
