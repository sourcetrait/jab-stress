[
    {
        name: "census_node_clamp",
        file: "census.S",
        edits: [
            { find: "    ble t3, t5, 1f\n    mv t3, t5\n1:\n    srl t3, t3, t0                  # the first column's cell\n", put: "    srl t3, t3, t0                  # the first column's cell\n" },
            { find: "    ble t4, t5, 2f\n    mv t4, t5\n2:\n    srl t4, t4, t0\n    addi t4, t4, 1                  # the last column's far node\n", put: "    srl t4, t4, t0\n    addi t4, t4, 1                  # the last column's far node\n    addi t5, t5, 1\n    srl t5, t5, t0\n    bleu t3, t5, 1f\n    mv t3, t5\n1:\n    bleu t4, t5, 2f\n    mv t4, t5\n2:\n" },
        ],
        expect: "the tile past the last node shaded by its nodes",
    },
    {
        name: "census_verify_trusting",
        file: "census.S",
        edits: [
            { find: "    mv tp, a4\n    mv a0, a3\n    ret\n", put: "    mv tp, a4\n    li a0, 1\n    ret\n" },
        ],
        expect: "the tile past the last node shaded at lumel_sample's texel centres",
    },
    {
        name: "census_verify_refusing",
        file: "census.S",
        edits: [
            { find: "    mv tp, a4\n    mv a0, a3\n    ret\n", put: "    mv tp, a4\n    li a0, 0\n    ret\n" },
        ],
        expect: "no tile uniform by its nodes and not by lumel_sample",
    },
    {
        name: "census_classifier_false",
        file: "census.S",
        edits: [
            { find: "8:\n    li a0, 1\n    ret\n9:\n    li a0, 0\n    ret\n", put: "8:\n    li a0, 0\n    ret\n9:\n    li a0, 0\n    ret\n" },
        ],
        expect: "the ordinary light's uniform tiles checked by lumel_sample",
    },
    {
        name: "census_relit_ignored",
        file: "console.S",
        edits: [
            { find: "    call lumels_bright\n.ifdef CENSUS\n    la t0, census_stale\n    li t1, 1\n    sb t1, 0(t0)                    # the census's uniformity unknown again\n.endif\n", put: "    call lumels_bright\n" },
            { find: "    call lumels_parity              # every lumel by its node's parity\n.ifdef CENSUS\n    la t0, census_stale\n    li t1, 1\n    sb t1, 0(t0)\n.endif\n", put: "    call lumels_parity              # every lumel by its node's parity\n" },
        ],
        expect: "the lighting's revisions in order",
    },
    {
        name: "census_uniform_ored",
        file: "census.S",
        edits: [
            { find: "    li t2, 1\n    slli t3, t2, CENSUS_KNOWN_BIT\n    slli t2, t2, CENSUS_UNIFORM_BIT\n    or t2, t2, t3\n    not t2, t2\n", put: "    li t2, 1\n    slli t3, t2, CENSUS_KNOWN_BIT\n    mv t2, t3\n    not t2, t2\n" },
            { find: "    li t1, 1\n    slli t1, t1, CENSUS_UNIFORM_BIT\n    not t1, t1\n    and t0, t0, t1                  # the verdict in place of any before it\n", put: "" },
        ],
        expect: "under the parity no tile uniform and none checked",
    },
    {
        name: "census_split_never",
        file: "census.S",
        edits: [
            { find: "    bleu t0, s6, 31f                # room for the longest item\n", put: "    j 31f\n" },
        ],
        expect: "every list of two surfaces or more split under the shrunk chunk",
    },
    {
        name: "census_split_drops",
        file: "census.S",
        edits: [
            { find: "    la a1, word_census_more\n    call append_str\n    li s5, 0\n31:\n", put: "    la a1, word_census_more\n    call append_str\n    li s5, 0\n    addi s4, s4, 1\n    j 3b\n31:\n" },
        ],
        expect: "every census frame whole and accounting",
        reason: "does not reassemble",
    },
    {
        name: "census_window_swapped",
        file: "census.S",
        edits: [
            { find: "    xori t4, t4, 1                  # its window's class by the surface: a plane, else a wall with its openings\n", put: "" },
        ],
        expect: "every census frame whole and accounting",
        reason: "planes' working set this frame",
    },
    {
        name: "census_chunk_ignored",
        file: "census.S",
        edits: [
            { find: "    la t0, census_chunk\n    lwu s6, 0(t0)\n", put: "    li s6, 0\n" },
        ],
        expect: "frames under the shrunk chunk",
    },
    {
        name: "census_ids_dropped",
        file: "census.S",
        edits: [
            { find: "    la a1, word_census_space\n    call append_str\n    ld a1, 0(sp)\n    call append_dec\n    la a1, word_census_colon\n    call append_str\n", put: "    la a1, word_census_space\n    call append_str\n" },
        ],
        expect: "every census frame whole and accounting",
        reason: "an item that is no surface:count pair",
    },
    {
        name: "census_directory_three",
        file: "census.S",
        edits: [
            { find: "    li a1, CENSUS_CONTEXTS\n    call append_dec                 # the count every frame's context lines are read against\n", put: "    li a1, 3\n    call append_dec                 # the count every frame's context lines are read against\n" },
        ],
        expect: "every census frame whole and accounting",
        reason: "unexpected: side",
    },
    {
        name: "census_class_shift_three",
        file: "census.S",
        edits: [
            { find: ".set CENSUS_CLASS_SHIFT, (CENSUS_CONTEXT_SHIFT + CENSUS_CONTEXTS)\n", put: ".set CENSUS_CLASS_SHIFT, (CENSUS_CONTEXT_SHIFT + 3)\n" },
        ],
        expect: "every census frame whole and accounting",
    },
]
