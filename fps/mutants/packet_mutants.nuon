# FramePackets' rules, each broken by exact-once finds and puts on a
# candidate copy of src/ (operation.md: the program's mutants against the
# suite); `expect` is the head of the assertion in test.nu that must fail.
# A change to a rule's source moves its finds here in the same pass.
[
  {
    name: flush_drops,
    file: "raster.S",
    edits: [{ find: "    j packet_render\n", put: "    la t0, span_count\n    sd zero, 0(t0)\n    la t0, command_count\n    sd zero, 0(t0)\n    ret\n" }],
    expect: "the spawn view drawn in packets of"
  },
  {
    name: scratch_leftover,
    file: "raster.S",
    edits: [{ find: "    ld a6, CTX_COMMAND(tp)\n    ld a1, POLY_MIPS(a6)", put: "    la a6, poly\n    ld a1, POLY_MIPS(a6)" }],
    expect: "no program or worker fault drawing the plain run's frames"
  },
  {
    name: record_preparation_whole,
    file: "main.S",
    edits: [{ find: "    sub t2, t2, t4\n    divu t2, t2, t6\n    sw t2, PACKET_PREPARATION(t1)", put: "    divu t2, t2, t6\n    sw t2, PACKET_PREPARATION(t1)" }],
    expect: "frames whose drawing is not their preparation and their raster"
  },
  {
    name: record_snapshot_stale,
    file: "main.S",
    edits: [{ find: "    sd s8, CLOCK_SNAPSHOT(t1)", put: "    sd zero, CLOCK_SNAPSHOT(t1)" }],
    expect: "frames whose packets were prepared from another frame's simulation"
  },
  {
    name: record_bytes_commands,
    file: "main.S",
    edits: [{ find: "    add t2, t2, t4\n    sw t2, PACKET_BYTES(t1)", put: "    sw t2, PACKET_BYTES(t1)" }],
    expect: "frames whose packets' bytes are not their commands' and their span records'"
  }
]
