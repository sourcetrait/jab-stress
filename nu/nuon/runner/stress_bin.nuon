{
 nonce: "",
 title: "A workbench bin's verb in the jab-stress checkout under an environment, logged",
 definition: "def execute [data: record<stress: string, bin: string, verb: string, words: list<string>, env: table<name: string, value: string>, log: string, label: string, mcp_nom: string, max_quiet_min: int>]: nothing -> record<label: string, nonce: string> {
    use equip/ai/two/rig/prototype/long
    let a = $data
    let bin = ($a.stress | path join nu bin nuance.nu)
    let given = ($a | to nuon)
    let ready = (^$bin runner ready stress_bin $given | complete)
    if $ready.exit_code != 0 { error make { msg: $\"stress_bin is not ready: ($ready.stderr | str trim)\" } }
    let r = ($ready.stdout | from nuon)
    let handle = (long launch {
        label: $a.label,
        mcp_nom: $a.mcp_nom,
        interval: 120sec,
        max_quiet: ($a.max_quiet_min * 1min),
        check: {|state| { log: ($a.log | path exists) } },
        teardown: null,
        work: {
            let w = (^$bin runner work stress_bin $given | complete)
            if $w.exit_code != 0 { error make { msg: $\"stress_bin: ($w.stderr | str trim)\" } }
            $w.stdout | from nuon
        },
    })
    { label: $handle.label, nonce: $handle.nonce }
}"
}