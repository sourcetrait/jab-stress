{
 nonce: "",
 title: "walk's CADENCE runs in a declared order, each batch a condition's image and kernel",
 args_type: "record<stress: string, jab: string, base: string, batches: table<label: string, image: string, kernel: string, spec: string, runs: int>, label: string, mcp_nom: string, max_quiet_min: int>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready walk_battery $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"walk_battery is not ready: ($ready.stderr | str trim)\" } }
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 120sec,
    max_quiet: ($a.max_quiet_min * 1min),
    check: {|state| { batches: (glob ($a.base | path join \"*.log\") | length), runs: (glob ($a.base | path join \"*\" \"run_*\") | length) } },
    teardown: null,
    work: {
        let w = (^$bin runner work walk_battery $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"walk_battery: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
