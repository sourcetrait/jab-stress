{
 nonce: "cnPbYB4L8Qt",
 title: "GfxScaling's selections on three, four, and eight harts, settled and factory",
 args_type: "record<stress: string, gauge: string, fps: string, new: string, base62: string, settled: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string, batteries: table<name: string, batches: int>>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready scaling_batteries $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"scaling_batteries is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 90min,
    check: {|state| { batteries: ($r.batteries | where {|b| ($b.base | path join \"compare_critical_us.txt\") | path exists } | length), runs: ($r.batteries | each {|b| glob ($b.base | path join \"*\" \"run_*\" \"serial.log\") | length } | math sum) } },
    teardown: null,
    work: {
        let w = (^$bin runner work scaling_batteries $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"scaling_batteries: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce, batteries: ($r.batteries | each {|b| { name: $b.name, batches: $b.batches } }) }"
}
