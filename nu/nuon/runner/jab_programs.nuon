{
 nonce: "by9bKI422wl",
 title: "Several programs' tests through jab's driver in turn",
 args_type: "record<stress: string, jab: string, log: string, label: string, mcp_nom: string, paths: list<string>>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready jab_programs $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"jab_programs is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 25min,
    check: {|state| { log: (if ($a.log | path exists) { 1 } else { 0 }) } },
    teardown: null,
    work: {
        let w = (^$bin runner work jab_programs $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"jab_programs: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
