{
 nonce: "dejKUeGaBDY",
 title: "Gauge batches at each one's workers and grain, compared by field",
 args_type: "record<stress: string, base: string, fps: string, batches: table<label: string, image: string, workers: int, grain: int>, runs: int, cadence: int, route: string, cpu: bool, fields: list<string>, log_glob: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready worker_battery $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"worker_battery is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 45min,
    check: {|state| { batches: (glob ($a.base | path join $a.log_glob) | length) } },
    teardown: null,
    work: {
        let w = (^$bin runner work worker_battery $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"worker_battery: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
