{
 nonce: "74NShk2ITRc",
 title: "Steps through jab's or the workbench's bins, each one's sources, artifacts, and outputs recorded",
 args_type: "record<stress: string, out: string, label: string, mcp_nom: string, max_quiet_min: int, kernel_source: string, steps: table<name: string, repo: string, bin: string, words: list<string>, symbols: string, programs: list<string>, fixtures: list<string>, outs: list<string>>>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/two/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready recorded $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"recorded is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: ($a.max_quiet_min * 1min),
    check: {|state| { steps: (glob ($r.out | path join \"*\" \"step.nuon\") | length), of: $r.steps } },
    teardown: null,
    work: {
        let w = (^$bin runner work recorded $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"recorded: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
