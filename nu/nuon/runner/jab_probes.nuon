{
 nonce: "",
 title: "One program's sdl probes in a declared order, each run's probe directory kept",
 definition: "def execute [data: record<stress: string, jab: string, program: string, probe_dir: string, base: string, runs: table<label: string, words: list<string>>, label: string, max_quiet_min: int>]: nothing -> record<label: string, nonce: string> {
    use equip/ai/two/rig/prototype/long
    let a = $data
    let bin = ($a.stress | path join nu bin nuance.nu)
    let given = ($a | to nuon)
    let ready = (^$bin runner ready jab_probes $given | complete)
    if $ready.exit_code != 0 { error make { msg: $\"jab_probes is not ready: ($ready.stderr | str trim)\" } }
    let handle = (long launch {
        label: $a.label,
        interval: 120sec,
        max_quiet: ($a.max_quiet_min * 1min),
        check: {|state| { runs: (glob ($a.base | path join \"*\" \"record.nuon\") | length) } },
        teardown: null,
        work: {
            let w = (^$bin runner work jab_probes $given | complete)
            if $w.exit_code != 0 { error make { msg: $\"jab_probes: ($w.stderr | str trim)\" } }
            $w.stdout | from nuon
        },
    })
    { label: $handle.label, nonce: $handle.nonce }
}"
}