{
 nonce: "5xxvnEklzjA",
 title: "Worker parity and fault steps on one kernel, each step's verdict read",
 args_type: "record<stress: string, base: string, nuance: string, kernel: string, steps: table<name: string, recipe: string, image: string, flags: list<string>>, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready scaling_parity $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"scaling_parity is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 70min,
    check: {|state| { verdicts: (glob ($a.base | path join \"*\" \"verdict.nuon\") | length), launches: (glob ($a.base | path join \"*\" \"*\" \"serial.log\") | length) } },
    teardown: null,
    work: {
        let w = (^$bin runner work scaling_parity $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"scaling_parity: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
