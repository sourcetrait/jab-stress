{
 nonce: "cTG7TJmr4Ev",
 title: "Workers 3 to 7 at four grains on eight harts, alternated, compared",
 args_type: "record<stress: string, base: string, fps: string, image: string, route: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string, batches: int>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready scaling_sweep $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"scaling_sweep is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 45min,
    check: {|state| { batches: (glob ($a.base | path join \"*.log\") | length), runs: (glob ($a.base | path join \"*\" \"run_*\" \"serial.log\") | length) } },
    teardown: null,
    work: {
        let w = (^$bin runner work scaling_sweep $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"scaling_sweep: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce, batches: $r.batches }"
}
