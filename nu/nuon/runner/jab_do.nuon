{
 nonce: "dR0Dw4OaNOd",
 title: "A root driver's verb in the jab checkout under an environment, logged",
 args_type: "record<stress: string, jab: string, bin: string, verb: string, words: list<string>, env: table<name: string, value: string>, log: string, label: string, mcp_nom: string, max_quiet_min: int>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready jab_do $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"jab_do is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 120sec,
    max_quiet: ($a.max_quiet_min * 1min),
    check: {|state| { log: ($a.log | path exists) } },
    teardown: null,
    work: {
        let w = (^$bin runner work jab_do $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"jab_do: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
