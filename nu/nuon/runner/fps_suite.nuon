{
 nonce: "TdeqIjHzeN",
 title: "fierce's tests through jab's driver, its gauge lines returned",
 args_type: "record<stress: string, fps: string, program: string, set: string, log: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready fps_suite $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"fps_suite is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 20min,
    check: {|state| { log: ($a.log | path exists) } },
    teardown: null,
    work: {
        let w = (^$bin runner work fps_suite $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"fps_suite: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
