{
 nonce: "kIeogaHfFvC",
 title: "Gauge batches at their cadences, compared with a baseline",
 args_type: "record<stress: string, base: string, fps: string, batches: table<label: string, cadence: int>, baseline: list<string>, fields: list<string>, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready cadence_battery $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"cadence_battery is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 30min,
    check: {|state| { batches: (glob ($a.base | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        let w = (^$bin runner work cadence_battery $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"cadence_battery: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
