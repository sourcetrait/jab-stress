{
 nonce: "gR3wbjWhASv",
 title: "fierce's development smoke by its bin",
 args_type: "record<stress: string, nuance: string, smoke_dir: string, log: string, seeds: string, seconds: int, mcp_nom: string, label: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let bin = ($a.stress | path join nu bin nuance.nu)
let given = ($a | to nuon)
let ready = (^$bin runner ready smoke $given | complete)
if $ready.exit_code != 0 { error make { msg: $\"smoke is not ready: ($ready.stderr | str trim)\" } }
let r = ($ready.stdout | from nuon)
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 10min,
    check: {|state| { entries: (if ($a.smoke_dir | path exists) { ls $a.smoke_dir | length } else { 0 }) } },
    teardown: null,
    work: {
        let w = (^$bin runner work smoke $given | complete)
        if $w.exit_code != 0 { error make { msg: $\"smoke: ($w.stderr | str trim)\" } }
        $w.stdout | from nuon
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
