{
  hosts: [
    { host: box, targets: [1ka1 1kb1], deciding: { guest: guest, display: display, walk: walk } }
  ],
  legs: [start fight spawn yard up down ramp revisit pressure],
  calibration: { host: box, battery: guest, kernel: P0 },
  batteries: [
    {
      battery: guest, host: box, workload: fps, backend: headless, runs: 3, per_condition: 6, seeds: [1 2 3],
      conditions: [
        { name: p0, kernel: P0, order: prepare, timing: false, probed: false, image: fps }
        { name: p2, kernel: P2, order: prepare, timing: false, probed: false, image: fps }
      ],
      batches: [p0 p2 p2 p0]
    }
    {
      battery: display, host: box, workload: fps, backend: offscreen, runs: 3, per_condition: 6, seeds: [1 2 3],
      conditions: [
        { name: p0_probed, kernel: P0, order: prepare, timing: false, probed: true, image: fps }
        { name: p2_probed, kernel: P2, order: prepare, timing: false, probed: true, image: fps }
        { name: p0, kernel: P0, order: prepare, timing: false, probed: false, image: fps }
        { name: p2, kernel: P2, order: prepare, timing: false, probed: false, image: fps }
      ],
      batches: [p0_probed p2_probed p0 p2 p2 p0 p2_probed p0_probed]
    }
    {
      battery: walk, host: box, workload: walk, backend: headless, runs: 3, per_condition: 6,
      seeds: [2685821657736338717 2685821657736338717 2685821657736338717],
      conditions: [
        { name: p0_await_on, kernel: P0, order: await, timing: true, probed: false, image: walk_await_timing }
        { name: p2_await_on, kernel: P2, order: await, timing: true, probed: false, image: walk_await_timing }
        { name: p2_prepare_on, kernel: P2, order: prepare, timing: true, probed: false, image: walk_prepare_timing }
        { name: p0_await_off, kernel: P0, order: await, timing: false, probed: false, image: walk_await }
        { name: p2_prepare_off, kernel: P2, order: prepare, timing: false, probed: false, image: walk_prepare }
      ],
      batches: [p0_await_on p2_await_on p2_prepare_on p0_await_off p2_prepare_off p2_prepare_off p0_await_off p2_prepare_on p2_await_on p0_await_on]
    }
  ]
}
