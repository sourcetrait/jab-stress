{
 nonce: lxdJlTCbEzM,
 args_type: "record<jab: string, log: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 25min,
    check: {|state| { log: (if ($a.log | path exists) { 1 } else { 0 }) } },
    teardown: null,
    work: {
        cd $a.jab
        let r = (^just test | complete)
        let text = ($r.stdout + \"\\n--- stderr\\n\" + $r.stderr)
        $text | save --raw -f $a.log
        let table = ($text | lines | where {|l| ($l =~ '│') and (($l =~ 'true') or ($l =~ 'false')) })
        let failed = ($table | where {|l| $l =~ 'false' })
        let n = ($text | str length)
        let start = ([0 ($n - 1500)] | math max)
        { exit: $r.exit_code, rows: ($table | length), failed: $failed, tail: ($text | str substring $start..) }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}