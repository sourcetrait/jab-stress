{
 nonce: "ezpNNwv1r0j",
 args_type: "record<jab: string, wt: string, commit: string, riscv: string, qemu: string, logs: string, mcp_nom: string, runs: table<name: string, heads: table<file: string, rev: string>, edits: table<file: string, find: string, put: string>, expect: string>>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
mkdir $a.logs
long launch {
    label: \"MipCorrectness against the code before\",
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 20min,
    check: {|state| { logs: (glob ($a.logs | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        def apply-edit [file: string, find: string, put: string] {
            let text = (open --raw $file | decode)
            let n = (($text | split row $find | length) - 1)
            if $n != 1 { error make { msg: $\"an edit's text occurs ($n) times in ($file): ($find | str substring 0..80)\" } }
            $text | str replace $find $put | save --raw -f $file
        }
        if not ($a.wt | path exists) {
            let added = (^git -C $a.jab worktree add --detach $a.wt $a.commit | complete)
            if $added.exit_code != 0 { error make { msg: $\"worktree: ($added.stderr)\" } }
            mkdir ($a.wt | path join \"extern\")
            ^ln -s $a.riscv ($a.wt | path join \"extern\" \"riscv\")
            ^ln -s $a.qemu ($a.wt | path join \"extern\" \"qemu\")
            let assets = ($a.wt | path join \"game\" \"fps\" \"1k\" \".target\" \"asset\")
            mkdir $assets
            for m in [cage2 doortest] { cp -r ($a.jab | path join \"game\" \"fps\" \"1k\" \".target\" \"asset\" $m) $assets }
            mkdir ($a.wt | path join \".target\")
            for t in [fetch generic shim] { cp -r ($a.jab | path join \".target\" $t) ($a.wt | path join \".target\") }
            for t in [mix.romfs mix.flags] { cp ($a.jab | path join \".target\" $t) ($a.wt | path join \".target\" $t) }
            let k = (do { cd $a.wt; ^just build --set debug } | complete)
            if $k.exit_code != 0 { error make { msg: $\"the worktree's build: ($k.stderr | str substring 0..800)\" } }
        }
        let touched = ($a.runs | each {|r| ($r.edits | get -o file | default []) | append ($r.heads | get -o file | default []) } | flatten | uniq)
        $a.runs | each {|run|
            for f in $touched { ^git -C $a.wt show $\"HEAD:($f)\" | save --raw -f ($a.wt | path join $f) }
            for h in $run.heads { ^git -C $a.wt show $\"($h.rev):($h.file)\" | save --raw -f ($a.wt | path join $h.file) }
            for e in $run.edits { apply-edit ($a.wt | path join $e.file) $e.find $e.put }
            let t = (do { cd ($a.wt | path join \"game\" \"fps\" \"1k\"); ^just test } | complete)
            let text = ([$t.stdout $t.stderr] | str join (char nl))
            $text | save --raw -f ($a.logs | path join $\"($run.name).log\")
            let hits = ($text | lines | where {|l| $l =~ $run.expect } | first 3 | each {|l| $l | str substring 0..300 })
            { name: $run.name, exit: $t.exit_code, ok: ($t.stdout | lines | any {|l| $l == \"fps: ok\" }), hits: $hits }
        }
    },
}"
}