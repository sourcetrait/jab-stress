{
 nonce: "5g6hE6ot8h5",
 args_type: "record<game: string, jf: string, mutants: string, manifest_file: string, cands: string, logs: string, assets: string, kernel: string, label: string, mcp_nom: string, control_file: string, ok: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
use /home/box/proj/sourcetrait/jab-stress/runners/provenance.nu [failure-of assertion-kind]

let a = $args
if ($a.logs | path exists) { error make { msg: $\"($a.logs) exists; a mutant set is written once\" } }
for p in [$a.assets $a.kernel $a.manifest_file $a.mutants] { if not ($p | path exists) { error make { msg: $\"missing: ($p)\" } } }
let manifest = (open --raw $a.manifest_file | decode)
mkdir $a.logs
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 30min,
    check: {|state| { logs: (glob ($a.logs | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        let set = ([{ name: \"control\", file: $a.control_file, edits: [], expect: \"\" }] | append (open $a.mutants))
        let results = ($set | each {|mu|
            let dir = ($a.cands | path join $\"packets_($mu.name)\")
            if ($dir | path type) == \"dir\" {
                if not ($dir | str starts-with $a.cands) { error make { msg: $\"($dir) is not under ($a.cands)\" } }
                rm -r $dir
            }
            mkdir $dir
            cp -r ($a.game | path join \"src\") $dir
            $manifest | save --raw -f ($dir | path join \"program.jab.toml\")
            let target = ($dir | path join \"src\" $mu.file)
            mut text = (open --raw $target | decode)
            mut applied = true
            for e in $mu.edits {
                let count = (($text | split row $e.find | length) - 1)
                if $count != 1 { $applied = false } else { $text = ($text | str replace $e.find $e.put) }
            }
            let reason = ($mu | get -o reason | default \"\")
            let credited = ($mu | get -o credited | default true)
            if not $applied {
                { name: $mu.name, applied: false, built: false, exit: null, failed_where: false, credited: $credited, reason: $reason, title: \"\" }
            } else {
                $text | save --raw -f $target
                let b = (^just -f $a.jf cand-build $dir | complete)
                let image = (glob ($dir | path join \"**\" \"fps.jab\") | get -o 0)
                if $b.exit_code != 0 or $image == null {
                    ($b.stdout + $b.stderr) | save --raw -f ($a.logs | path join $\"($mu.name).build.log\")
                    { name: $mu.name, applied: true, built: false, exit: $b.exit_code, failed_where: false, credited: $credited, reason: $reason, title: \"\" }
                } else {
                    let r = (^just -f $a.jf image-test $image ($a.logs | path join $mu.name) $a.assets $a.kernel | complete)
                    let log = ($r.stdout + $r.stderr)
                    $log | save --raw -f ($a.logs | path join $\"($mu.name).log\")
                    let ls = ($log | lines)
                    let failure = (failure-of $ls)
                    let flat = ($failure.title | str replace --all --regex '\\s+' ' ')
                    let failed_where = (if $mu.name == \"control\" {
                        $r.exit_code == 0 and ($ls | any {|l| $l starts-with $a.ok })
                    } else {
                        $r.exit_code != 0 and (assertion-kind $ls $failure) != null and $mu.expect != \"\" and ($flat | str contains $mu.expect) and ($reason == \"\" or ($flat | str contains $reason))
                    })
                    { name: $mu.name, applied: true, built: true, exit: $r.exit_code, failed_where: $failed_where, credited: $credited, reason: $reason, title: ($flat | str substring 0..300) }
                }
            }
        })
        let control = ($results | where name == \"control\" | get 0)
        let mutants = ($results | where name != \"control\")
        {
            control_ok: ($control.applied and $control.built and $control.failed_where),
            every: ($mutants | all {|x| $x.applied and $x.built and $x.failed_where == $x.credited }),
            results: ($results | select name applied built exit failed_where credited reason),
            misses: ($mutants | where {|x| not ($x.applied and $x.built and $x.failed_where == $x.credited) }),
        }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}