{
 nonce: "kg4fq8DXxBF",
 args_type: "record<jab: string, set: string, only: list<string>, control: record<program: string, ok: string>, logs: string, deadline: int, hold: record<at: string, seconds: int>, proc: string>",
 result_type: "record<control_ok: bool, every: bool, restored: bool, cleaned: bool, caught: int, unrun: list<string>, head: string, logs: string, deadline: int, swept: int, results: table<name: string, applied: bool, exit: oneof<int, nothing>, class: string, expected: string, title: string, seconds: float, swept: int>, misses: table<name: string, applied: bool, exit: oneof<int, nothing>, class: string, expected: string, title: string, seconds: float, swept: int>, finished: float, in_time: bool, ok: bool>",
 body: "use /home/box/proj/sourcetrait/jab-stress/runners/provenance.nu [failure-of assertion-kind]
use /home/box/proj/sourcetrait/jab-stress/runners/guard.nu [MARK STAGE raise-cancel proc-stat marked sweep strays stage land]

const MARGIN = 15
const KILL_AFTER = 5
const SWEEP_WAIT = 2sec

let a = $args
let started = (date now)
let since = {|| ((date now) - $started) / 1sec | into float }
let root = ($a.jab | path expand)
let jf = ($root | path join \"justfile\")
let call = $env.NONCE
if $a.deadline < ($MARGIN + 1) { error make {msg: $\"a deadline of ($a.deadline) s leaves no allowance past the ($MARGIN) s margin\"} }
if ($a.logs | path type) != null { error make {msg: $\"($a.logs) exists; a set's logs are written once\"} }
if ($a.only | is-empty) { error make {msg: \"`only` names no mutant\"} }
if $a.hold.at not-in [\"\" \"staged\" \"renamed\" \"finish\" \"receipt\"] { error make {msg: $\"hold at ($a.hold.at): staged, renamed, finish, receipt, or none\"} }
let set = (open $a.set)
let names = ($set | get name)
let twice = ($names | uniq --repeated)
if not ($twice | is-empty) { error make {msg: $\"the set names ($twice | str join ', ') more than once\"} }
if \"control\" in $names { error make {msg: \"the set holds a mutant named control, the control's own name\"} }
let unknown = ($a.only | where {|n| $n not-in $names })
if not ($unknown | is-empty) { error make {msg: $\"`only` names ($unknown | str join ', '), which the set does not hold\"} }
let chosen = ($set | where {|m| $m.name in $a.only })
let foreign = ($chosen | where {|m| $m.program != $a.control.program })
if not ($foreign | is-empty) { error make {msg: $\"($foreign | get name | str join ', ') test a program other than the control's, ($a.control.program)\"} }
let top = (^git -C $root rev-parse --show-toplevel | complete)
if $top.exit_code != 0 or (($top.stdout | str trim | path expand) != $root) { error make {msg: $\"($root) is no git checkout's top\"} }
let commit = (^git -C $root rev-parse HEAD | str trim)
let host = (proc-stat $a.proc $nu.pid)
let leftover = (marked $a.proc \"\")
if not ($leftover | is-empty) { error make {msg: $\"processes carry a runner's mark, recover their call first: ($leftover | each {|f| $'($f.pid) ($f.mark) ($f.cmd)' } | str join '; ')\"} }
let lying = (strays $root \"\")
if not ($lying | is-empty) { error make {msg: $\"staged files lie in the checkout, recover their call first: ($lying | str join '; ')\"} }
let files = ($chosen | each {|m| $m.edits | get file } | flatten | uniq)
mut paths = []
mut dirty = []
for f in $files {
    let p = ($root | path join $f)
    let committed = (^git -C $root show $\"($commit):($f)\" | into binary)
    let committed_hash = ($committed | hash sha256)
    let current_hash = (open --raw $p | into binary | hash sha256)
    let porcelain = (^git -C $root status --porcelain -- $f | str trim)
    if $current_hash != $committed_hash or $porcelain != \"\" { $dirty = ($dirty | append $f) }
    $paths = ($paths | append { file: $f, path: $p, committed: $committed, hash: $committed_hash })
}
if not ($dirty | is-empty) { error make {msg: $\"the checkout differs from ($commit) at ($dirty | str join ', '), where the set writes; it must be clean there\"} }
let paths_now = $paths
mut plans = []
for m in $chosen {
    mut writes = []
    mut fault = \"\"
    for e in $m.edits {
        let prior = ($writes | where file == $e.file | get -o 0.text)
        let base = (if $prior != null { $prior } else { $paths_now | where file == $e.file | get 0.committed | decode })
        let n = (($base | split row $e.find | length) - 1)
        if $n != 1 {
            if $fault == \"\" { $fault = $\"($e.file): the find matches ($n) times\" }
        } else {
            $writes = ($writes | where file != $e.file | append { file: $e.file, text: ($base | str replace -n $e.find $e.put) })
        }
    }
    let w = ($writes | each {|x| let b = ($x.text | into binary); { file: $x.file, path: ($root | path join $x.file), bytes: $b, hash: ($b | hash sha256) } })
    $plans = ($plans | append { name: $m.name, fault: $fault, writes: (if $fault == \"\" { $w } else { [] }) })
}
let plans_now = $plans
mkdir $a.logs
let streams = ($env.XDGX_SHM_DIR | path join \"mcp\" \"run\" $call)
mkdir $streams
let stamp = ($started | format date \"%Y-%m-%dT%H:%M:%S%.3f%z\")
{
    call: $call,
    mark: $MARK,
    stage: $STAGE,
    root: $root,
    commit: $commit,
    set: ($a.set | path expand),
    set_sha256: (open --raw $a.set | into binary | hash sha256),
    only: $a.only,
    control: $a.control,
    deadline: $a.deadline,
    margin: $MARGIN,
    kill_after: $KILL_AFTER,
    hold: $a.hold,
    started: $stamp,
    paths: ($paths_now | each {|p| { file: $p.file, committed: $p.hash, mutated: ($plans_now | each {|pl| $pl.writes | where file == $p.file | each {|w| { mutant: $pl.name, hash: $w.hash } } } | flatten) } }),
} | to nuon --indent 1 | save --raw ($a.logs | path join \"baseline.nuon\")
let status_before = (^git -C $root status --porcelain --untracked-files=all | lines)
let runs = ([{ name: \"control\", program: $a.control.program, expect: \"\", fault: \"\", writes: [] }] | append ($chosen | each {|m| let pl = ($plans_now | where name == $m.name | first); $m | merge { fault: $pl.fault, writes: $pl.writes } }))
mut rows = []
mut unrun = []
mut sweeps = []
mut longest = 0.0
mut restored = true
mut cleaned = true
mut halted = false
for mu in $runs {
    let allowance = ($a.deadline - (do $since) - $MARGIN)
    let is_control = ($mu.name == \"control\")
    let need = (if $is_control { 1.0 } else { [$longest 1.0] | math max })
    if $halted or ($allowance < $need) {
        $unrun = ($unrun | append $mu.name)
        $halted = true
        continue
    }
    let expected = ($mu.class? | default (if $is_control { \"passed\" } else { \"caught\" }))
    if $mu.fault != \"\" {
        $rows = ($rows | append { name: $mu.name, applied: false, exit: null, class: \"unapplied\", expected: $expected, title: $mu.fault, seconds: 0.0, swept: 0 })
        continue
    }
    let mark = $\"($call):($mu.name)\"
    let out = ($streams | path join $\"($mu.name).stdout\")
    let err = ($streams | path join $\"($mu.name).stderr\")
    # Each write staged and renamed into place. A hold sleeps outside any
    # catch, so a cancel there stops the call as a lost host would.
    mut note = \"\"
    for w in $mu.writes {
        let st = (try { { path: (stage $w.path $w.bytes $w.hash $call), msg: \"\" } } catch {|e| raise-cancel $e; { path: \"\", msg: $e.msg } })
        if $st.msg != \"\" { $note = $\"runner: ($st.msg)\"; break }
        if $a.hold.at == \"staged\" { sleep ($a.hold.seconds * 1sec) }
        let landed = (try { land $st.path $w.path $w.hash; \"\" } catch {|e| raise-cancel $e; $e.msg })
        if $landed != \"\" { $note = $\"runner: ($landed)\"; break }
    }
    if $note == \"\" and $a.hold.at == \"renamed\" and not ($mu.writes | is-empty) { sleep ($a.hold.seconds * 1sec) }
    let left = ($a.deadline - (do $since) - $MARGIN)
    let r = (if $note != \"\" {
        { ran: false, faulted: true, note: $note, exit_code: null, signal: false, took: 0.0, secs: 0 }
    } else if $left < 1.0 {
        { ran: false, faulted: false, note: \"\", exit_code: null, signal: false, took: 0.0, secs: 0 }
    } else {
        let secs = ($left | math floor | into int)
        let t0 = (date now)
        let x = (with-env ({} | insert $MARK $mark) {
            try {
                ^timeout --signal=TERM $\"--kill-after=($KILL_AFTER)s\" $\"($secs)s\" just --justfile $jf --working-directory $root test $mu.program o> $out e> $err
                { exit_code: 0, signal: false, faulted: false, note: \"\" }
            } catch {|e|
                let code = ($e.details?.code? | default \"\")
                let took = (((date now) - $t0) / 1sec | into float)
                if $code == \"nu::shell::non_zero_exit_code\" {
                    { exit_code: $e.exit_code, signal: false, faulted: false, note: \"\" }
                } else if $code == \"nu::shell::terminated_by_signal\" and $took >= $secs {
                    { exit_code: $e.exit_code, signal: true, faulted: false, note: \"\" }
                } else {
                    raise-cancel $e
                    { exit_code: null, signal: false, faulted: true, note: $\"runner: ($e.msg)\" }
                }
            }
        })
        $x | merge { ran: true, took: (((date now) - $t0) / 1sec | into float), secs: $secs }
    })
    let sw = (sweep $a.proc $\"($call):\" $nu.pid $host.pgid $started $SWEEP_WAIT)
    $sweeps = ($sweeps | append { name: $mu.name, records: $sw.records, left: $sw.left, scans: $sw.scans, ended: $sw.ended })
    # A process the sweep could not end holds the run's files back for the
    # recovery, which itself touches nothing while one remains.
    let unswept = not ($sw.left | is-empty)
    if $unswept {
        $cleaned = false
        $halted = true
    } else {
        mut held = true
        for w in $mu.writes {
            let p = ($paths_now | where file == $w.file | first)
            let now_hash = (open --raw $w.path | into binary | hash sha256)
            if $now_hash != $p.hash {
                let back = (try { let s = (stage $w.path $p.committed $p.hash $call); land $s $w.path $p.hash; true } catch {|e| raise-cancel $e; false })
                if not $back { $held = false }
            }
        }
        let all_held = ($paths_now | all {|p| (open --raw $p.path | into binary | hash sha256) == $p.hash })
        if not ($held and $all_held) { $restored = false; $halted = true }
    }
    if not $r.ran and not $r.faulted and not $unswept {
        $unrun = ($unrun | append $mu.name)
        $halted = true
        continue
    }
    let stdout = (try { open --raw $out | into binary | decode } catch {|e| raise-cancel $e; \"\" })
    let stderr = (try { open --raw $err | into binary | decode } catch {|e| raise-cancel $e; \"\" })
    let log = ($stdout + $stderr + $r.note)
    $log | save --raw -f ($a.logs | path join $\"($mu.name).log\")
    let ls = ($log | lines)
    let failure = (failure-of $ls)
    let kind = (assertion-kind $ls $failure)
    let carries = ($mu.expect != \"\" and ($failure.title | str contains $mu.expect))
    let over = ((not $r.faulted) and ($r.signal or ($r.exit_code == 124 and $r.took >= ($r.secs - 1))))
    let class = (if $unswept {
        \"unswept\"
    } else if $r.faulted {
        \"faulted\"
    } else if $over {
        \"overrun\"
    } else if $is_control {
        if $r.exit_code == 0 and ($ls | any {|l| $l starts-with $a.control.ok }) { \"passed\" } else { \"failed\" }
    } else if $r.exit_code == 0 {
        \"missed\"
    } else if $kind != null and $carries and ($failure.title | str contains \"unexercised\") {
        \"unexercised\"
    } else if $kind != null and $carries {
        \"caught\"
    } else {
        \"missed\"
    })
    let title = (if $r.faulted { $r.note } else { $failure.title })
    $rows = ($rows | append { name: $mu.name, applied: true, exit: $r.exit_code, class: $class, expected: $expected, title: ($title | str substring -g 0..<300), seconds: ($r.took | math round --precision 1), swept: ($sw.records | length) })
    if $r.took > $longest { $longest = $r.took }
    if $r.faulted or $over { $halted = true }
    if $is_control and $class != \"passed\" { $halted = true }
}
let status_after = (^git -C $root status --porcelain --untracked-files=all | lines)
let left_staged = (strays $root $call)
let hashes = ($paths_now | all {|p| (open --raw $p.path | into binary | hash sha256) == $p.hash })
let done = $rows
let unrun_now = $unrun
let sweeps_now = $sweeps
let cleaned_now = $cleaned
let control = ($done | where name == \"control\" | get -o 0)
let mutants = ($done | where name != \"control\")
let holds = {|x| $x.class == $x.expected and $x.class not-in [\"unapplied\" \"faulted\" \"overrun\" \"unswept\"] }
let results = {
    control_ok: ($control != null and $control.class == \"passed\"),
    every: (($unrun_now | is-empty) and ($mutants | all $holds)),
    restored: ($restored and $hashes and ($status_after == $status_before) and ($left_staged | is-empty)),
    cleaned: $cleaned_now,
    caught: ($mutants | where class == \"caught\" | length),
    unrun: $unrun_now,
    head: $commit,
    logs: $a.logs,
    deadline: $a.deadline,
    swept: (if ($sweeps_now | is-empty) { 0 } else { $sweeps_now | each {|s| $s.records | length } | math sum }),
    results: $done,
    misses: ($mutants | where {|x| not (do $holds $x) }),
}
# The results written once and never rewritten; the deadline ends at that
# write, and the verdict follows in a receipt bound to its bytes.
if $a.hold.at == \"finish\" { sleep ($a.hold.seconds * 1sec) }
let bytes = ($results | merge { call: $call, started: $stamp, sweeps: $sweeps_now, status: $status_before, status_after: $status_after, staged_after: $left_staged } | to nuon --indent 1 | into binary)
$bytes | save --raw ($a.logs | path join \"results.nuon\")
let elapsed = (do $since)
let in_time = ($elapsed <= $a.deadline)
let ok = ($results.control_ok and $results.every and $results.restored and $results.cleaned and $in_time)
let finished = ($elapsed | math round --precision 3)
if $a.hold.at == \"receipt\" { sleep ($a.hold.seconds * 1sec) }
{ call: $call, results: \"results.nuon\", results_sha256: ($bytes | hash sha256), finished: $finished, deadline: $a.deadline, in_time: $in_time, ok: $ok } | to nuon --indent 1 | save --raw ($a.logs | path join \"receipt.nuon\")
$results | merge { finished: $finished, in_time: $in_time, ok: $ok }"
}