{
 nonce: "49AGzVbsa3Y",
 args_type: "record<jf: string, kernel: string, root: string, sets: table<name: string, image: string>, maps: table<map: string, poses: string>, base: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
let caps = ($a.root | path join captures)
if ($caps | path exists) { error make { msg: $\"the captures exist: ($caps)\" } }
mkdir $caps
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 20min,
    check: {|state| { shots: (glob ($caps | path join \"**\" \"screen.ppm\") | length) } },
    teardown: null,
    work: {
        let rows = ($a.maps | each {|m|
            $a.sets | each {|s|
                let out = ($caps | path join $s.name $m.map)
                let r = (^just -f $a.jf pose-map $m.map $s.image $m.poses $out $a.kernel | complete)
                ($r.stdout + $r.stderr) | save --raw -f ($caps | path join $\"($s.name)_($m.map).log\")
                glob ($out | path join \"*\" \"screen.ppm\") | each {|f|
                    { set: $s.name, map: $m.map, pose: ($f | path dirname | path basename), capture: (open --raw $f | hash sha256), exit: $r.exit_code }
                }
            } | flatten
        } | flatten)
        $rows | to nuon | save -f ($a.root | path join \"captures.nuon\")
        let base = ($rows | where set == $a.base)
        let compared = ($rows | where set != $a.base | each {|r|
            let want = ($base | where map == $r.map and pose == $r.pose | get -o 0.capture)
            { set: $r.set, map: $r.map, pose: $r.pose, same: ($want != null and $want == $r.capture) }
        })
        { captures: ($rows | length), exits: ($rows | get exit | uniq), base: ($base | length), same: ($compared | where same | length), differ: ($compared | where {|c| not $c.same } | each {|c| $\"($c.set) ($c.pose)\" }) }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}