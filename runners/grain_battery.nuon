{
 nonce: "ikAsVUiu7ti",
 args_type: "record<gauge: string, fps: string, image: string, settled: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string, batteries: table<name: string, batches: int>>",
 body: "use rig/sourcetrait/emptwo/prototype/long
# ThreeWorkerGrain (FrameCeiling): forced W 3 at 16 and 32 rows on one
# image, so the height is the one difference; on four and eight harts,
# the settled and the factory routes; four batches a height in the order
# 16 32 32 16 16 32 32 16, each three runs seeded 1 to 3, so every batch
# has its partner of the other height beside it
let order = [16 32 32 16 16 32 32 16]
let batches = ($order | enumerate | each {|o|
    let nth = ($order | first ($o.index + 1) | where {|g| $g == $o.item } | length)
    { label: $\"g($o.item)_($nth)\", workers: 3, grain: $o.item }
})
let names = { \"4\": \"four\", \"8\": \"eight\" }
let batteries = ([4 8] | each {|h| [{ route: $args.settled, kind: \"settled\" } { route: \"\", kind: \"factory\" }] | each {|r|
    let name = $\"($names | get ($h | into string))_($r.kind)\"
    { name: $name, base: ($args.gauge | path join $name), harts: $h, route: $r.route }
} } | flatten)
let a = { fps: $args.fps, image: $args.image, runs: 3, cadence: 1, fields: [critical_us raster_us], batches: $batches, batteries: $batteries, label: $args.label, mcp_nom: $args.mcp_nom }
let taken = ($a.batteries | where {|b| $b.base | path exists })
if ($taken | is-not-empty) { error make { msg: $\"battery bases exist: ($taken | get base | str join ', ')\" } }
if not ($a.image | path exists) { error make { msg: $\"image missing: ($a.image)\" } }
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 45min,
    check: {|state| { batteries: ($a.batteries | where {|b| ($b.base | path join \"compare_critical_us.txt\") | path exists } | length), runs: ($a.batteries | each {|b| glob ($b.base | path join \"*\" \"run_*\" \"serial.log\") | length } | math sum) } },
    teardown: null,
    work: {
        mut results = []
        for bat in $a.batteries {
            mkdir $bat.base
            for b in $a.batches {
                let out = ($bat.base | path join $b.label)
                let route = (if $bat.route == \"\" { [] } else { [--route $bat.route] })
                let r = (do { cd $a.fps; ^just do gauge release ($a.runs | into string) --cadence ($a.cadence | into string) --harts ($bat.harts | into string) --workers ($b.workers | into string) --grain ($b.grain | into string) --image $a.image ...$route --out $out --label $b.label } | complete)
                ($r.stdout + $r.stderr) | save --raw -f ($bat.base | path join $\"($b.label).log\")
                if $r.exit_code != 0 { error make { msg: $\"($bat.name) ($b.label) exited ($r.exit_code): (($r.stdout + $r.stderr) | lines | last 6 | str join ' | ' | str substring 0..900)\" } }
            }
            let files = ($a.batches | each {|b| $bat.base | path join $b.label \"gauge.nuon\" })
            mut compares = []
            for f in $a.fields {
                let c = (do { cd $a.fps; ^just do gauge-compare ...$files --field $f --diagnostic --out ($bat.base | path join $\"compare_($f).nuon\") } | complete)
                ($c.stdout + $c.stderr) | save --raw -f ($bat.base | path join $\"compare_($f).txt\")
                $compares = ($compares | append { field: $f, exit: $c.exit_code })
            }
            $results = ($results | append { name: $bat.name, batches: ($a.batches | length), compares: $compares })
        }
        { batteries: $results }
    },
})
{ label: $handle.label, nonce: $handle.nonce, batteries: ($batteries | each {|b| { name: $b.name, batches: ($batches | length) } }) }"
}
