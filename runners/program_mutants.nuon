{
 nonce: "ap6BdZ4ELNf",
 args_type: "record<game: string, jf: string, mutants: string, manifest: string, cands: string, logs: string, assets: string, kernel: string, label: string, mcp_nom: string, ok: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long

# The log's first error: its title, the `  x ` line with its `  | `
# continuations joined, and the index of the line after them.
def failure-of [ls: list<string>]: nothing -> record<title: string, after: int> {
    let start = ($ls | enumerate | where {|e| $e.item starts-with \"  x \" } | get -o 0.index)
    if $start == null { return {title: \"\", after: -1} }
    let more = ($ls | skip ($start + 1) | take while {|l| $l starts-with \"  | \" })
    {
        title: ([($ls | get $start | str substring 4..)] | append ($more | each {|l| $l | str substring 4.. }) | str join \" \"),
        after: ($start + 1 + ($more | length)),
    }
}

# The assertion whose own failure the error is: `assert` or `assert equal`
# when the header right after its title names an excerpt line whose code
# up to the header's column is that assertion's head, alone or after a
# block's brace or a semicolon, and the labels under that line are the
# assertion's own, `It is not true.`, or `left:` and `right:` under a
# title closing `These are not equal.`; null for any other failure.
def assertion-kind [ls: list<string>, failure: record<title: string, after: int>] {
    if $failure.after < 0 { return null }
    let header = ($ls | get -o $failure.after | default \"\" | parse --regex '^\\s*,-\\[(?P<file>.+):(?P<line>\\d+):(?P<col>\\d+)\\]$' | get -o 0)
    if $header == null { return null }
    let excerpt = ($ls | skip ($failure.after + 1) | take until {|l| $l =~ '^\\s*`----' })
    let at = ($excerpt | enumerate | where {|e| ($e.item | parse --regex '^\\s*(?P<n>\\d+) \\|' | get -o 0.n) == $header.line } | get -o 0.index)
    if $at == null { return null }
    let code = ($excerpt | get $at | parse --regex '^\\s*\\d+ \\| ?(?P<code>.*)$' | get 0.code)
    let head = ($code | str substring 0..<(($header.col | into int) - 1))
    let kind = ($head | parse --regex '(?:^|[{;])\\s*(?P<kind>assert(?: equal)?) $' | get -o 0.kind)
    if $kind == null { return null }
    let labels = ($excerpt | skip ($at + 1) | take while {|l| $l =~ '^\\s*:' })
    let own = (if $kind == \"assert\" {
        $labels | any {|l| $l | str contains \"`-- It is not true.\" }
    } else {
        ($labels | any {|l| $l | str contains \"`-- left:\" }) and ($labels | any {|l| $l | str contains \"`-- right:\" }) and ($failure.title | str ends-with \"These are not equal.\")
    })
    if $own { $kind } else { null }
}

let a = $args
if ($a.logs | path exists) { error make { msg: $\"($a.logs) exists; a mutant set is written once\" } }
mkdir $a.logs
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 30min,
    check: {|state| { logs: (glob ($a.logs | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        let set = ([{ name: \"control\", file: \"raster.S\", edits: [], expect: \"\" }] | append (open $a.mutants))
        let results = ($set | each {|mu|
            let dir = ($a.cands | path join $\"packets_($mu.name)\")
            if ($dir | path type) == \"dir\" {
                if not ($dir | str starts-with $a.cands) { error make { msg: $\"($dir) is not under ($a.cands)\" } }
                rm -r $dir
            }
            mkdir $dir
            cp -r ($a.game | path join \"src\") $dir
            $a.manifest | save --raw -f ($dir | path join \"program.jab.toml\")
            let target = ($dir | path join \"src\" $mu.file)
            mut text = (open --raw $target | decode)
            mut applied = true
            for e in $mu.edits {
                let count = (($text | split row $e.find | length) - 1)
                if $count != 1 { $applied = false } else { $text = ($text | str replace $e.find $e.put) }
            }
            let expected = ($mu.class? | default (if $mu.name == \"control\" { \"passed\" } else { \"caught\" }))
            if not $applied {
                { name: $mu.name, applied: false, built: false, exit: null, class: \"unapplied\", expected: $expected, title: \"\" }
            } else {
                $text | save --raw -f $target
                let b = (^just -f $a.jf cand-build $dir | complete)
                let image = (glob ($dir | path join \"**\" \"fps.jab\") | get -o 0)
                if $b.exit_code != 0 or $image == null {
                    ($b.stdout + $b.stderr) | save --raw -f ($a.logs | path join $\"($mu.name).build.log\")
                    { name: $mu.name, applied: true, built: false, exit: $b.exit_code, class: \"unbuilt\", expected: $expected, title: \"\" }
                } else {
                    let fixtures = ($mu.fixtures? | default [])
                    let r = (^just -f $a.jf image-test $image ($a.logs | path join $mu.name) $a.assets $a.kernel ...$fixtures | complete)
                    let log = ($r.stdout + $r.stderr)
                    $log | save --raw -f ($a.logs | path join $\"($mu.name).log\")
                    let ls = ($log | lines)
                    let failure = (failure-of $ls)
                    let kind = (assertion-kind $ls $failure)
                    let carries = ($mu.expect != \"\" and ($failure.title | str contains $mu.expect))
                    let class = (if $mu.name == \"control\" {
                        if $r.exit_code == 0 and ($ls | any {|l| $l starts-with $a.ok }) { \"passed\" } else { \"failed\" }
                    } else if $r.exit_code == 0 {
                        \"missed\"
                    } else if $kind != null and $carries and ($failure.title | str contains \"unexercised\") {
                        \"unexercised\"
                    } else if $kind != null and $carries {
                        \"caught\"
                    } else {
                        \"missed\"
                    })
                    { name: $mu.name, applied: true, built: true, exit: $r.exit_code, class: $class, expected: $expected, title: ($failure.title | str substring 0..300) }
                }
            }
        })
        let control = ($results | where name == \"control\" | get 0)
        let mutants = ($results | where name != \"control\")
        {
            control_ok: ($control.class == \"passed\"),
            every: ($mutants | all {|x| $x.class == $x.expected }),
            caught: ($mutants | where class == \"caught\" | length),
            results: ($results | select name applied built exit class expected title),
            misses: ($mutants | where {|x| $x.class != $x.expected }),
        }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}