{
 nonce: "cTG7TJmr4Ev",
 args_type: "record<base: string, fps: string, image: string, route: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string, batches: int>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let first = ([3 4 5 6 7] | each {|w| [0 16 32 64] | each {|g| { label: $\"w($w)g($g)_1\", harts: 8, workers: $w, grain: $g, image: $args.image } } } | flatten)
let second = ($first | reverse | each {|b| $b | update label ($b.label | str replace '_1' '_2') })
let a = { base: $args.base, fps: $args.fps, batches: ($first ++ $second), runs: 3, cadence: 1, route: $args.route, cpu: false, fields: [critical_us raster_us], diagnostic: true, label: $args.label, mcp_nom: $args.mcp_nom }
if ($a.base | path exists) { error make { msg: $\"($a.base) exists; a battery is written once\" } }
let missing = ($a.batches | where {|b| $b.image != \"\" and not ($b.image | path exists) })
if ($missing | is-not-empty) { error make { msg: $\"image missing: ($missing | get image | str join ', ')\" } }
mkdir $a.base
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 45min,
    check: {|state| { batches: (glob ($a.base | path join \"*.log\") | length), runs: (glob ($a.base | path join \"*\" \"run_*\" \"serial.log\") | length) } },
    teardown: null,
    work: {
        mut done = []
        for b in $a.batches {
            let out = ($a.base | path join $b.label)
            let image = (if $b.image == \"\" { [] } else { [--image $b.image] })
            let route = (if $a.route == \"\" { [] } else { [--route $a.route] })
            let cpu = (if $a.cpu { [--cpu] } else { [] })
            let selection = (if $b.workers < 0 { [] } else { [--workers ($b.workers | into string) --grain ($b.grain | into string)] })
            let r = (do { cd $a.fps; ^just do gauge release ($a.runs | into string) --cadence ($a.cadence | into string) --harts ($b.harts | into string) ...$selection ...$cpu ...$image ...$route --out $out --label $b.label } | complete)
            ($r.stdout + $r.stderr) | save --raw -f ($a.base | path join $\"($b.label).log\")
            if $r.exit_code != 0 { error make { msg: $\"($b.label) exited ($r.exit_code): (($r.stdout + $r.stderr) | lines | last 6 | str join ' | ' | str substring 0..900)\" } }
            $done = ($done | append $b.label)
        }
        let files = ($a.batches | each {|b| $a.base | path join $b.label \"gauge.nuon\" })
        let diag = (if $a.diagnostic { [--diagnostic] } else { [] })
        let compares = ($a.fields | each {|f|
            let c = (do { cd $a.fps; ^just do gauge-compare ...$files --field $f ...$diag --out ($a.base | path join $\"compare_($f).nuon\") } | complete)
            ($c.stdout + $c.stderr) | save --raw -f ($a.base | path join $\"compare_($f).txt\")
            { field: $f, exit: $c.exit_code }
        })
        { batches: $done, compares: $compares }
    },
})
{ label: $handle.label, nonce: $handle.nonce, batches: ($a.batches | length) }"
}