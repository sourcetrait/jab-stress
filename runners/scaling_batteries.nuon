{
 nonce: "cnPbYB4L8Qt",
 args_type: "record<gauge: string, fps: string, new: string, base62: string, settled: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string, batteries: table<name: string, batches: int>>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let selections = {|harts: int|
  let base = (if $harts == 3 { [{ label: \"base62\", image: $args.base62, workers: -1, grain: 32 }] } else { [] })
  let auto = [{ label: \"auto\", image: $args.new, workers: -1, grain: 32 }]
  let forced = (0..<$harts | each {|w| { label: $\"w($w)\", image: $args.new, workers: $w, grain: 32 } })
  let first = ($base ++ $auto ++ $forced | each {|s| $s | update label $\"($s.label)_1\" })
  $first ++ ($first | reverse | each {|s| $s | update label ($s.label | str replace '_1' '_2') })
}
let names = { \"3\": \"three\", \"4\": \"four\", \"8\": \"eight\" }
let batteries = ([3 4 8] | each {|h| [{ route: $args.settled, kind: \"settled\" } { route: \"\", kind: \"factory\" }] | each {|r|
  let name = $\"($names | get ($h | into string))_($r.kind)\"
  { name: $name, base: ($args.gauge | path join $name), harts: $h, route: $r.route, batches: (do $selections $h) }
} } | flatten)
let a = { fps: $args.fps, runs: 3, cadence: 1, cpu: true, fields: [critical_us raster_us], batteries: $batteries, label: $args.label, mcp_nom: $args.mcp_nom }
let taken = ($a.batteries | where {|b| $b.base | path exists })
if ($taken | is-not-empty) { error make { msg: $\"battery bases exist: ($taken | get base | str join ', ')\" } }
let missing = ($a.batteries | get batches | flatten | where {|b| $b.image != \"\" and not ($b.image | path exists) } | get image | uniq)
if ($missing | is-not-empty) { error make { msg: $\"image missing: ($missing | str join ', ')\" } }
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 90min,
    check: {|state| { batteries: ($a.batteries | where {|b| ($b.base | path join \"compare_critical_us.txt\") | path exists } | length), runs: ($a.batteries | each {|b| glob ($b.base | path join \"*\" \"run_*\" \"serial.log\") | length } | math sum) } },
    teardown: null,
    work: {
        mut results = []
        for bat in $a.batteries {
            mkdir $bat.base
            for b in $bat.batches {
                let out = ($bat.base | path join $b.label)
                let image = (if $b.image == \"\" { [] } else { [--image $b.image] })
                let route = (if $bat.route == \"\" { [] } else { [--route $bat.route] })
                let cpu = (if $a.cpu { [--cpu] } else { [] })
                let selection = (if $b.workers < 0 { [] } else { [--workers ($b.workers | into string) --grain ($b.grain | into string)] })
                let r = (do { cd $a.fps; ^just do gauge release ($a.runs | into string) --cadence ($a.cadence | into string) --harts ($bat.harts | into string) ...$selection ...$cpu ...$image ...$route --out $out --label $b.label } | complete)
                ($r.stdout + $r.stderr) | save --raw -f ($bat.base | path join $\"($b.label).log\")
                if $r.exit_code != 0 { error make { msg: $\"($bat.name) ($b.label) exited ($r.exit_code): (($r.stdout + $r.stderr) | lines | last 6 | str join ' | ' | str substring 0..900)\" } }
            }
            let files = ($bat.batches | each {|b| $bat.base | path join $b.label \"gauge.nuon\" })
            let diag = (if $bat.harts != 3 { [--diagnostic] } else { [] })
            mut compares = []
            for f in $a.fields {
                let c = (do { cd $a.fps; ^just do gauge-compare ...$files --field $f ...$diag --out ($bat.base | path join $\"compare_($f).nuon\") } | complete)
                ($c.stdout + $c.stderr) | save --raw -f ($bat.base | path join $\"compare_($f).txt\")
                $compares = ($compares | append { field: $f, exit: $c.exit_code })
            }
            $results = ($results | append { name: $bat.name, batches: ($bat.batches | length), compares: $compares })
        }
        { batteries: $results }
    },
})
{ label: $handle.label, nonce: $handle.nonce, batteries: ($batteries | each {|b| { name: $b.name, batches: ($b.batches | length) } }) }"
}