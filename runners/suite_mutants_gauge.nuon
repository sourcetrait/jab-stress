{
 nonce: "9d6SqpW9Y17",
 args_type: "record<game: string, jf: string, logs: string, assets: string, images: table<name: string, image: string, expect: list<string>>, gauge_out: string, gauge_label: string, read_out: string, old: list<string>, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
if ($a.logs | path exists) { error make { msg: $\"($a.logs) exists; a sequence is written once\" } }
mkdir $a.logs
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 30min,
    check: {|state| { logs: (glob ($a.logs | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        let t = (do { cd $a.game; ^just test } | complete)
        ($t.stdout + $t.stderr) | save --raw -f ($a.logs | path join \"suite.log\")
        let lines = ($t.stdout | lines)
        let suite = {
            exit: $t.exit_code,
            ok: ($lines | any {|l| $l == \"fps: ok\" }),
            clock: ($lines | where {|l| $l starts-with \"fps: the clock\" } | str join \" | \" | str substring 0..600),
            tail: ($lines | last 2 | str join \" | \" | str substring 0..400),
            err: ($t.stderr | str substring 0..1000),
        }
        let mutants = ($a.images | each {|m|
            let out = ($a.logs | path join $m.name)
            let r = (^just -f $a.jf image-test $m.image $out $a.assets | complete)
            let text = ($r.stdout + $r.stderr)
            $text | save --raw -f ($a.logs | path join $\"($m.name).log\")
            {
                name: $m.name, exit: $r.exit_code,
                failed_where: ($m.expect | any {|e| $text | str contains $e }),
                which: ($m.expect | where {|e| $text | str contains $e }),
                walked: ($text | lines | any {|l| $l starts-with \"fps: the gauge's rules\" }),
            }
        })
        let g = (do { cd $a.game; ^just gauge release 1 \"--out\" $a.gauge_out \"--label\" $a.gauge_label } | complete)
        ($g.stdout + $g.stderr) | save --raw -f ($a.logs | path join \"gauge.log\")
        let gauge_file = ($a.gauge_out | path join \"gauge.nuon\")
        let reread = (^just -f $a.jf gauge-read-out ($a.gauge_out | path join \"run_1\" \"api.out\") $a.read_out | complete)
        ($reread.stdout + $reread.stderr) | save --raw -f ($a.logs | path join \"read.log\")
        let cmp = (do { cd $a.game; ^just gauge-compare $gauge_file ...$a.old } | complete)
        ($cmp.stdout + $cmp.stderr) | save --raw -f ($a.logs | path join \"compare.log\")
        {
            suite: $suite,
            mutants: $mutants,
            gauge: { exit: $g.exit_code, run: ($g.stdout | lines | where {|l| $l starts-with \"gauge: presentation: run 1\" } | str join \" | \" | str substring 0..700) },
            read: { exit: $reread.exit_code, run: ($reread.stdout | lines | where {|l| $l starts-with \"gauge: run 1\" } | str join \" | \" | str substring 0..500) },
            compare: { exit: $cmp.exit_code, lines: (($cmp.stdout + $cmp.stderr) | lines | first 14 | str join \" | \" | str substring 0..1600) },
        }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}