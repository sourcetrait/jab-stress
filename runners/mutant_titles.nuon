{
 nonce: "e1petZD11qo",
 args_type: "record<out: string, mutants: string>",
 result_type: "record<all: bool, rows: table<name: string, title: string, at_assert: bool, matches: bool>>",
 body: "use /home/box/proj/sourcetrait/jab-stress/runners/provenance.nu [failure-of assertion-kind]

let ms = (open $args.mutants)
let rows = ($ms | each {|m|
    let ls = (open --raw ($args.out | path join $\"($m.name).log\") | decode | lines)
    let failure = (failure-of $ls)
    let at_assert = ((assertion-kind $ls $failure) != null)
    let matches = ($m.expect != \"\" and ($failure.title | str contains $m.expect))
    let as_expected = ($at_assert == ($m | get -o at_assert | default true) and $matches == ($m | get -o matches | default true))
    { name: $m.name, title: ($failure.title | str substring 0..160), at_assert: $at_assert, matches: $matches, as_expected: $as_expected }
})
{ all: ($rows | all {|r| $r.as_expected }), rows: ($rows | where {|r| not $r.as_expected } | reject as_expected) }"
}