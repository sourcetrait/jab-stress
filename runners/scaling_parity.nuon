{
 nonce: "5xxvnEklzjA",
 args_type: "record<base: string, jf: string, kernel: string, steps: table<name: string, recipe: string, image: string, flags: list<string>>, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
if ($a.base | path exists) { error make { msg: $\"($a.base) exists; a parity is written once\" } }
mkdir $a.base
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 70min,
    check: {|state| { verdicts: (glob ($a.base | path join \"*\" \"verdict.nuon\") | length), launches: (glob ($a.base | path join \"*\" \"*\" \"serial.log\") | length) } },
    teardown: null,
    work: {
        let results = ($a.steps | each {|s|
            let out = ($a.base | path join $s.name)
            let r = (^just -f $a.jf $s.recipe $a.kernel $s.image $out ...$s.flags | complete)
            ($r.stdout + $r.stderr) | save --raw -f ($a.base | path join $\"($s.name).log\")
            let v = ($out | path join \"verdict.nuon\")
            if ($v | path exists) { let x = (open $v); { name: $s.name, exit: $r.exit_code, ok: $x.ok, judged: $x.judged, failed: $x.failed } } else { { name: $s.name, exit: $r.exit_code, ok: false, judged: 0, failed: -1 } }
        })
        { ok: ($results | all {|x| $x.ok }), steps: $results }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}