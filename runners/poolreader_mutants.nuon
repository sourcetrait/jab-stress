{
 nonce: "2rM2CVU5KzA",
 revised_from: "b45PFb5sQqo",
 args_type: "record<readers: string, jab: string, mutants: string, scratch: string, jf: string, gauge: string, admission: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
if ($a.scratch | path exists) { error make { msg: $\"the scratch exists: ($a.scratch)\" } }
mkdir $a.scratch
^ln -s $a.jab ($a.scratch | path join \"jab\")
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 40min,
    check: {|state| { logs: (glob ($a.scratch | path join \"*.log\") | length) } },
    teardown: null,
    work: {
        let files = [\"poolgauge.nu\" \"admission.nu\" \"tilecensus_resolve.nu\"]
        let src = ($files | reduce --fold {} {|f, acc| $acc | insert $f (open --raw ($a.readers | path join $f) | decode) })
        let mutants = (open $a.mutants)
        let counts = ($mutants | each {|m| { name: $m.name, n: ((($src | get $m.file) | split row $m.find | length) - 1) } })
        let bad = ($counts | where n != 1)
        if not ($bad | is-empty) { error make { msg: $\"finds not matching exactly once: ($bad | to nuon)\" } }
        let jobs = ([{ name: \"control\", file: null, find: null, put: null, expect: null }] | append $mutants)
        let results = ($jobs | par-each --threads 4 {|m|
            let tree = ($a.scratch | path join $m.name \"fps\" \"readers\")
            mkdir $tree
            for f in $files {
                let text = (if $m.file == $f { $src | get $f | str replace $m.find $m.put } else { $src | get $f })
                $text | save --raw ($tree | path join $f)
            }
            let ad = (^just -f $a.jf admission-holds ($tree | path join \"admission.nu\") $a.admission ($tree | path join \"ad_holds\") | complete)
            let pg = (if $ad.exit_code == 0 { ^just -f $a.jf poolgauge-holds ($tree | path join \"poolgauge.nu\") $a.gauge ($tree | path join \"pg_holds\") | complete } else { { stdout: \"\", stderr: \"\", exit_code: 0 } })
            let out = ($ad.stdout + $ad.stderr + $pg.stdout + $pg.stderr)
            $out | save --raw ($a.scratch | path join $\"($m.name).log\")
            let flat = ($out | str replace --all --regex '[\\s│|]+' ' ')
            let raised = ($flat | str contains \": raised: \")
            let exit = (if $ad.exit_code != 0 { $ad.exit_code } else { $pg.exit_code })
            let lines = ($out | lines)
            {
                name: $m.name, exit: $exit, raised: $raised,
                at_own: (if $m.expect == null { null } else { ($flat | str contains $m.expect) and (not $raised) }),
                ok: (($lines | any {|l| $l == \"admission holds: ok\" }) and ($lines | any {|l| $l == \"poolgauge holds: ok\" })),
            }
        })
        $results | to nuon | save ($a.scratch | path join \"results.nuon\")
        {
            control: ($results | where name == \"control\" | first),
            failing_at_own: ($results | where {|x| $x.name != \"control\" and $x.exit != 0 and $x.at_own } | length),
            raised: ($results | where raised | get name),
            others: ($results | where {|x| $x.name != \"control\" and not ($x.exit != 0 and $x.at_own) } | get name),
        }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}