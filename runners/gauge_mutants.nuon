{
 nonce: "kQ8CcwbGnHa",
 args_type: "record<jab: string, jf: string, mirror: string, scratch: string, rules: string, out: string, label: string, mcp_nom: string, game: list<string>, mutants_file: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = ($args | insert mutants (open $args.mutants_file))
let handle = (long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 90min,
    check: {|state| { logs: (if ($a.out | path exists) { glob ($a.out | path join \"*.log\") | length } else { 0 }) } },
    teardown: null,
    work: {
        let m = $a.mirror
        let g = $a.game
        for d in [$m $a.rules] {
            if not ($d | str starts-with $a.scratch) { error make { msg: $\"($d) is not under the scratch ($a.scratch)\" } }
            if ($d | path exists) { error make { msg: $\"($d) exists; a mirror and a rules directory are made fresh\" } }
        }
        if ($a.out | path exists) { error make { msg: $\"($a.out) exists; a mutant set is written once\" } }
        mkdir ($m | path join \"sdk\" \"nu\")
        mkdir ($m | path join ...$g \"nu\")
        mkdir ($m | path join ...$g \"test\")
        cp ($a.jab | path join \"sdk\" \"nu\" \"jab.nu\") ($m | path join \"sdk\" \"nu\")
        for f in [map.nu png.nu] { cp ($a.jab | path join ...$g \"nu\" $f) ($m | path join ...$g \"nu\") }
        for f in [test.nu gauge.nu pose.nu census.nu census_holds.nu tiles.nu] { cp ($a.jab | path join ...$g \"test\" $f) ($m | path join ...$g \"test\") }
        let gauge_file = ($m | path join ...$g \"test\" \"gauge.nu\")
        let original = (open --raw $gauge_file | decode)
        mkdir $a.out
        mkdir $a.rules
        let control = (^just -f $a.jf rules-mirror ($a.rules | path join \"control\") $m | complete)
        ($control.stdout + $control.stderr) | save --raw -f ($a.out | path join \"control.log\")
        let results = ($a.mutants | each {|mu|
            let count = (($original | split row $mu.find | length) - 1)
            if $count != 1 {
                { name: $mu.name, applied: false, count: $count, exit: null, failed_where: false, head: \"\" }
            } else {
                $original | str replace $mu.find $mu.put | save --raw -f $gauge_file
                let r = (^just -f $a.jf rules-mirror ($a.rules | path join $mu.name) $m | complete)
                let text = ($r.stdout + $r.stderr)
                $text | save --raw -f ($a.out | path join $\"($mu.name).log\")
                $original | save --raw -f $gauge_file
                let said = ($text | lines | where {|l| ($l | str contains \"×\") or ($l | str contains \"Error\") or ($l | str contains \"assert\") } | first 3 | str join \" | \")
                { name: $mu.name, applied: true, count: 1, exit: $r.exit_code, failed_where: ($text | str contains $mu.expect), head: ($said | str substring 0..240) }
            }
        })
        let restored = ((open --raw $gauge_file | decode) == $original)
        let summary = {
            control: { exit: $control.exit_code, ok: ($control.stdout | str contains \"rules: ok\"), tail: (($control.stdout + $control.stderr) | str substring 0..400) },
            restored: $restored,
            every: ($results | all {|x| $x.applied and $x.exit != 0 and $x.failed_where }),
            results: ($results | select name applied exit failed_where),
            misses: ($results | where {|x| not ($x.applied and $x.exit != 0 and $x.failed_where) }),
        }
        $summary | to nuon | save --raw -f ($a.out | path join \"summary.nuon\")
        $summary | reject results
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}