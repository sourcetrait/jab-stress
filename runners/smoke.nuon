{
 nonce: "goxxz3sFsiB",
 args_type: "record<jf: string, smoke_dir: string, log: string, seeds: string, seconds: int, mcp_nom: string, label: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let a = $args
long launch {
    label: $a.label,
    mcp_nom: $a.mcp_nom,
    interval: 60sec,
    max_quiet: 10min,
    check: {|state| {
        entries: (if ($a.smoke_dir | path exists) { ls $a.smoke_dir | length } else { 0 }),
    } },
    teardown: null,
    work: {
        let r = (^just -f $a.jf smoke $a.seeds $a.seconds | complete)
        ($r.stdout + $r.stderr) | save --raw -f $a.log
        let tail = ($r.stdout + $r.stderr | lines | where {|l| $l =~ '^smoke|rror|assert|FAULT' } | last 8)
        if $r.exit_code != 0 { error make { msg: $\"smoke exited ($r.exit_code): ($tail | str join ' | ')\" } }
        { exit: $r.exit_code, tail: $tail }
    },
}"
}