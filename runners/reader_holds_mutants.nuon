{
 nonce: "1gncsAJS7Ld",
 args_type: "record<readers: string, jab: string, mutants: string, scratch: string, jf: string, logs: string>",
 result_type: "record<control: record<exit: int, ok: bool>, results: table<name: string, exit: int, raised: bool, at_own: oneof<bool, nothing>>, every: bool, secs: int>",
 body: "let t0 = (date now)
let a = $args
if ($a.scratch | path exists) { error make { msg: $\"the scratch exists: ($a.scratch)\" } }
if ($a.logs | path exists) { error make { msg: $\"the logs exist: ($a.logs)\" } }
mkdir $a.scratch
mkdir $a.logs
^ln -s $a.jab ($a.scratch | path join \"jab\")
let files = [\"workergauge.nu\" \"packetgauge.nu\" \"lane.nu\" \"gaincurves.nu\" \"batches.nu\"]
let scripts = [\"workergauge\" \"packetgauge\" \"lane\" \"gaincurves\"]
let src = ($files | reduce --fold {} {|f, acc| $acc | insert $f (open --raw ($a.readers | path join $f) | decode) })
let mutants = (open $a.mutants)
let bad = ($mutants | each {|m| { name: $m.name, n: ((($src | get $m.file) | split row $m.find | length) - 1) } } | where n != 1)
if not ($bad | is-empty) { error make { msg: $\"finds not matching exactly once: ($bad | to nuon)\" } }
let jobs = ([{ file: null, name: \"control\", find: null, put: null, expect: null }] | append $mutants)
let results = ($jobs | par-each --threads 4 {|m|
    let tree = ($a.scratch | path join $m.name \"fps\" \"readers\")
    mkdir $tree
    for f in $files {
        let text = (if $m.file == $f { $src | get $f | str replace $m.find $m.put } else { $src | get $f })
        $text | save --raw ($tree | path join $f)
    }
    let outs = ($scripts | each {|s| ^just -f $a.jf reader-holds ($tree | path join $\"($s).nu\") ($a.scratch | path join $m.name $\"($s)_holds\") | complete })
    let out = ($outs | each {|o| $o.stdout + $o.stderr } | str join \"\")
    $out | save --raw ($a.logs | path join $\"($m.name).log\")
    let flat = ($out | str replace --all --regex '[\\s│|]+' ' ')
    let raised = ($flat | str contains \": raised: \")
    let lines = ($out | lines)
    {
        name: $m.name,
        exit: ($outs | get exit_code | where {|e| $e != 0 } | get -o 0 | default 0),
        raised: $raised,
        at_own: (if $m.expect == null { null } else { ($flat | str contains $m.expect) and (not $raised) }),
        ok: ($scripts | all {|s| $\"($s) holds: ok\" in $lines }),
    }
})
let control = ($results | where name == \"control\" | first)
let others = ($results | where name != \"control\")
{
    control: { exit: $control.exit, ok: $control.ok },
    results: ($others | select name exit raised at_own),
    every: ($others | all {|x| $x.exit != 0 and $x.at_own == true }),
    secs: (((date now) - $t0) / 1sec | math round),
}"
}
