{
 nonce: "dAwiMIRWJx9",
 args_type: "record<fps: string, program: string, set: string, log: string, label: string, mcp_nom: string>",
 result_type: "record<label: string, nonce: string>",
 body: "use rig/sourcetrait/emptwo/prototype/long
let fps = $args.fps
let program = $args.program
let set = $args.set
let log = $args.log
mkdir ($log | path dirname)
let handle = (long launch {
    label: $args.label,
    mcp_nom: $args.mcp_nom,
    interval: 60sec,
    max_quiet: 20min,
    check: {|state| { log: ($log | path exists) } },
    teardown: null,
    work: {
        let test = (if $set == \"\" { do { cd $fps; ^just test $program } | complete } else { do { cd $fps; ^just test $program --set $set } | complete })
        ($test.stdout + $test.stderr) | save --raw -f $log
        let lines = ($test.stdout | lines)
        let ok = (($test.exit_code == 0) and ($lines | any {|l| $l == \"fps: ok\" }))
        let gauge = ($lines | where {|l| $l starts-with \"fps: the gauge\" } | str join \" | \")
        if not $ok {
            error make { msg: $\"just test failed: exit ($test.exit_code); ($lines | last 2 | str join ' | ' | str substring 0..800) ($test.stderr | str substring 0..1500)\" }
        }
        { ok: $ok, exit: $test.exit_code, gauge: ($gauge | str substring 0..400) }
    },
})
{ label: $handle.label, nonce: $handle.nonce }"
}
